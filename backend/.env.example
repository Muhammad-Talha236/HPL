DATABASE_URL= your url database connection string
PORT=5000

JWT_SECRET="your-super-secret-key-change-this-later"
JWT_EXPIRES_IN="7d"

NODE_ENV=

# Account email delivery (Gmail App Password; never commit real values)
# Shared by account verification and password recovery. On Render set
# FRONTEND_URL=https://hpl-ten.vercel.app and NODE_ENV=production.
# Locally set FRONTEND_URL=http://localhost:5173 and NODE_ENV=development.
EMAIL_USER=
EMAIL_APP_PASSWORD=
EMAIL_FROM_NAME=Hunza Premier League
FRONTEND_URL=
# Optional comma-separated additional browser origins for local development.
FRONTEND_URLS=http://localhost:5173,http://127.0.0.1:5173


CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Required on Render as server-side environment variables. Never prefix these
# values with VITE_ and never expose the API secret to the frontend.
# Competition roster registration: receipts and images accept at most 5 MB.
# A lower limit can be configured in bytes; values above 5 MB are capped.
REGISTRATION_UPLOAD_MAX_BYTES=5242880
# Optional emails use existing EMAIL_* / FRONTEND_URL settings and verified mailboxes.
REGISTRATION_EMAIL_ENABLED=false
